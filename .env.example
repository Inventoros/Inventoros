APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Split installs (cPanel: app in ~/inventoros, web root in ~/public_html):
# the web root, absolute or relative to this folder. The installer and the
# in-app updater set it; CLI commands (plugin activation, php artisan update)
# use it to write to the folder the site serves. Leave unset for <app>/public.
# APP_PUBLIC_PATH=../public_html

# Public self-registration. Off by default: the installer provisions the first
# admin/organization, and a self-registered account is org-less with no access.
REGISTRATION_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# With the database queue, `schedule:run` also works the queue every minute
# (for hosts with no queue worker, e.g. cPanel). Set to false when a dedicated
# worker (Docker, systemd, Supervisor) runs `queue:work`.
# QUEUE_RUN_VIA_SCHEDULER=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Error & performance monitoring via Sentry. Disabled until a DSN is set —
# leave SENTRY_LARAVEL_DSN empty to keep it off. Defaults capture 100% of
# errors and sample 10% of performance traces.
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Plugin uploads are disabled by default. Enabling them lets any admin
# user upload a ZIP that is require_once'd into the application process,
# which means admin compromise becomes RCE. See SECURITY.md before
# turning this on.
INVENTOROS_ALLOW_PLUGIN_UPLOADS=false

# Optionally require uploaded plugins to carry a valid detached Ed25519
# signature (verified against this public key) before they are installed.
# Off by default; fails closed when on. Sign with `php artisan update:sign`.
# INVENTOROS_PLUGIN_SIGNATURE_REQUIRED=false
# INVENTOROS_PLUGIN_PUBLIC_KEY=

# Plugins are shared by every organization on the installation, so only one
# organization's admins may install, update or remove them: this one, or the
# first organization when unset.
# INVENTOROS_PLUGIN_ADMIN_ORG=

# In-app updater download URL allowlist (comma-separated prefixes).
# Defaults to this project's GitHub release endpoints. Override if you
# install from a fork or mirror. Updates from URLs that don't start with
# one of these prefixes are rejected before any bytes are downloaded.
# INVENTOROS_UPDATE_PREFIXES=https://github.com/Inventoros/Inventoros/releases/download/

# GitHub answers release downloads with a redirect to its storage hosts.
# Redirects are followed one hop at a time, https only, to these hosts.
# INVENTOROS_UPDATE_HOSTS=github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,codeload.github.com
# INVENTOROS_UPDATE_MAX_REDIRECTS=5
# INVENTOROS_UPDATE_MAX_DOWNLOAD_BYTES=209715200

# In-app updater signature verification. Releases ship a detached Ed25519
# signature (<asset>.zip.sig); the updater verifies the archive against this
# public key before extracting. Verification is REQUIRED by default and fails
# closed — if no key is set, updates are refused. Set the public key here, or
# set INVENTOROS_UPDATE_SIGNATURE_REQUIRED=false to install unsigned builds
# (not recommended). Generate a key with `php artisan update:signing-keypair`.
# The value below is the official Inventoros release-signing public key; the
# matching secret lives only in the Inventoros CI (INVENTOROS_UPDATE_SECRET_KEY).
INVENTOROS_UPDATE_PUBLIC_KEY=dtH972Sp6dfKcdT/NqdXOeBGSrTOfBHxJbdZ3UfRN24=
# INVENTOROS_UPDATE_SIGNATURE_REQUIRED=true
# INVENTOROS_UPDATE_SIGNATURE_SUFFIX=.sig

# Updater archive limits (defaults: 50000 entries, 300 MB extracted).
# INVENTOROS_UPDATE_MAX_ENTRIES=50000
# INVENTOROS_UPDATE_MAX_BYTES=314572800

# Restoring a pre-update backup (it also holds vendor/ and storage/).
# INVENTOROS_RESTORE_MAX_ENTRIES=500000
# INVENTOROS_RESTORE_MAX_BYTES=4294967296

# After installing the files the updater runs optimize:clear, migrate and
# optimize as `php artisan ...` in a new PHP process. Name the PHP CLI binary
# if it is not found next to the running PHP (cPanel example below); with
# proc_open disabled they run in the updating process instead.
# INVENTOROS_UPDATE_PHP_BINARY=/opt/cpanel/ea-php84/root/usr/bin/php
# INVENTOROS_UPDATE_ARTISAN_SUBPROCESS=true
# INVENTOROS_UPDATE_ARTISAN_TIMEOUT=900

# Every update takes a backup that must include the database (mysqldump,
# pg_dump, a SQLite snapshot or the built-in PHP dumper). If none works the
# update is refused. Set to true only if you back the database up some other
# way and accept a files-only backup.
# INVENTOROS_UPDATE_ALLOW_NO_DB_BACKUP=false

# Plugin ZIP limits for uploads and marketplace installs
# (defaults: 2000 entries, 50 MB extracted).
# INVENTOROS_PLUGIN_MAX_ENTRIES=2000
# INVENTOROS_PLUGIN_MAX_BYTES=52428800

# Plugin marketplace (Plugins > Marketplace). Packages are verified against
# the marketplace signing PUBLIC key below before anything is extracted;
# installs are refused while no key is configured. The app never trusts a key
# advertised by the marketplace itself.
# INVENTOROS_MARKETPLACE_URL=https://inventoros.com
# INVENTOROS_MARKETPLACE_PUBLIC_KEY=
# INVENTOROS_MARKETPLACE_CACHE_SECONDS=300
# INVENTOROS_MARKETPLACE_TIMEOUT=20
# INVENTOROS_MARKETPLACE_MAX_DOWNLOAD_BYTES=52428800

# Minutes to suppress repeat low-stock alerts for the same product (default 1440).
# LOW_STOCK_ALERT_COOLDOWN_MINUTES=1440

# Document emails (purchase orders, invoices) are rate limited so they cannot
# relay mail: per user per minute (default 10) and per organization per day (default 500).
# DOCUMENT_EMAILS_PER_USER_PER_MINUTE=10
# DOCUMENT_EMAILS_PER_ORGANIZATION_PER_DAY=500

# Maximum rows any report query returns (default 10000).
# REPORTS_MAX_ROWS=10000
# Maximum rows a report PDF export renders (default 1000; larger reports export to CSV or Excel).
# REPORTS_PDF_MAX_ROWS=1000

# Publish the /docs/api API reference to everyone (default: signed-in users only outside local)
API_DOCS_PUBLIC=false

# Default currency code (default USD).
# DEFAULT_CURRENCY=USD

# Serve the GraphiQL explorer (default false).
# ENABLE_GRAPHIQL=false

# When true, orders for serial- or batch-tracked products must be covered by
# tracked serials / batch quantity (default false: best effort).
# INVENTORY_STRICT_TRACKED_STOCK=false

# Imports and exports. Files up to IMPORT_SYNC_MAX_KB are imported in the
# request, larger ones are queued. Exports up to EXPORT_SYNC_ROW_LIMIT rows
# download directly, larger ones are queued and kept EXPORT_RETENTION_DAYS.
# IMPORT_DISK=local
# IMPORT_SYNC_MAX_KB=512
# EXPORT_DISK=local
# EXPORT_SYNC_ROW_LIMIT=1000
# EXPORT_RETENTION_DAYS=7
